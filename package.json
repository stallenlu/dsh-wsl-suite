{
  "name": "dsh-wsl-suite",
  "version": "0.1.9",
  "description": "WSL workspaces for DeepSeek Harness, served by one persistent in-distro agent instead of 9P polling.",
  "license": "MIT",
  "author": "stallenlu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stallenlu/dsh-wsl-suite.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "lib/index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./fs": "./lib/fs.js",
    "./shell": "./lib/shell.js",
    "./search": "./lib/search.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "agent/agent.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test \"tests/*.test.ts\"",
    "verify": "npm run typecheck && npm test",
    "prepack": "tsdown",
    "pretest": "tsdown"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-fs": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-sandbox": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-shell": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-subprocess": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.5",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox": {
      "optional": true
    },
    "@deepseek-ai/dsh-shell": {
      "optional": true
    },
    "@deepseek-ai/dsh-subprocess": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent-preset-registry": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.5",
    "@deepseek-ai/dsh-shell": "0.2.1-rc.5",
    "@deepseek-ai/dsh-skill": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tool-fs-search": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-web": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-workspace": "^0.2.1-rc.5",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "jsdom": "^26.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.13.5",
    "typescript": "^5.8.3"
  },
  "homepage": "https://github.com/stallenlu/dsh-wsl-suite#readme",
  "bugs": {
    "url": "https://github.com/stallenlu/dsh-wsl-suite/issues"
  }
}
